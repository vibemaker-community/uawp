{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uawp.dev/schemas/manifest-v1.schema.json",
  "title": "UAWP namespace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "stateVersion"],
  "properties": {
    "protocol": {
      "const": "UAWP"
    },
    "stateVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mode", "target", "consumers", "createdFile", "artifactSHA256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "mode": { "enum": ["DIRECT", "IMPORT", "MANAGED_BLOCK"] },
          "target": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
          },
          "createdFile": { "type": "boolean" },
          "artifactSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "outsideContentSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
